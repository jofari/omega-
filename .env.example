# Copie ce fichier en .env et remplis les valeurs (jamais commiter le .env reel — cf. .gitignore).

# Telegram (Telethon, compte utilisateur Jonas) — https://my.telegram.org pour api_id/api_hash
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=omega_session

# Destinataire des messages : le @username du BOT Hermes (ex. @hermes_bot), ou son ID numerique.
# ATTENTION : ce n'est PAS ton propre ID utilisateur (8869675077 = toi) — un message envoye a
# ton ID part dans "Messages enregistres" et Hermes ne repond jamais.
HERMES_TARGET=

# Delai max d'attente de la reponse d'Hermes, en secondes (ses vraies taches prennent 30 s a 2 min).
TELEGRAM_REPLY_TIMEOUT=180

# STT (faster-whisper)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# TTS (edge-tts)
TTS_VOICE=fr-FR-DeniseNeural

# Metriques cockpit (optionnel — laisser vide = "à configurer")
OPENROUTER_API_KEY=
# Duree de cache des metriques lentes de /status (secondes)
STATUS_CACHE_TTL=30

# Securite locale (optionnel)
# Secret partage page <-> backend (header X-Omega-Token). Vide = token aleatoire a chaque
# demarrage (il faut alors recharger la page apres un redemarrage / --reload).
OMEGA_SECRET=
# Hotes supplementaires acceptes (sans port), separes par des virgules, ex. pour un acces LAN :
# OMEGA_ALLOWED_HOSTS=192.168.1.10,mon-pc.local
OMEGA_ALLOWED_HOSTS=
